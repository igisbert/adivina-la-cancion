---
interface Props {
  id?: string;
}

const { id = "skip-button" } = Astro.props;
---

<button id={id} class="skip-button" aria-label="Saltar intento">
  <span>Saltar</span>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <polygon points="5 4 15 12 5 20 5 4"></polygon>
    <line x1="19" y1="5" x2="19" y2="19"></line>
  </svg>
</button>

<style>
  .skip-button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    height: 40px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    color: #71717a;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease-out, background 0.15s ease-out;
  }

  .skip-button:hover {
    color: #a1a1aa;
    background: rgba(255, 255, 255, 0.1);
  }

  .skip-button:active {
    transform: scale(0.95);
  }
</style>
