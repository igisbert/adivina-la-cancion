---
interface Props {
  id?: string;
}

const { id = "skip-button" } = Astro.props;
---

<button id={id} class="skip-button" aria-label="Saltar intento">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <polygon points="5 4 15 12 5 20 5 4"></polygon>
    <line x1="19" y1="5" x2="19" y2="19"></line>
  </svg>
  <span>Saltar</span>
</button>

<style>
  .skip-button {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 18px;
    height: 44px;
    background: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 10px;
    color: #a1a1aa;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease-out, color 0.15s ease-out;

  .skip-button:active {
    transform: scale(0.97);
  }
</style>
