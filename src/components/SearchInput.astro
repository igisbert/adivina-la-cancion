---
interface Props {
  placeholder?: string;
  id?: string;
}

const { placeholder = "Escribe tu respuesta...", id = "guess-input" } = Astro.props;
---

<div class="search-wrap">
  <input
    type="text"
    id={id}
    class="search-input"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
  />
  <div id="search-dropdown" class="search-dropdown"></div>
</div>

<style>
  .search-wrap {
    position: relative;
    width: 100%;
  }

  .search-input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    font-size: 15px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid transparent;
    border-radius: 12px;
    color: #fafafa;
    transition: background 0.2s ease-out, border-color 0.2s ease-out;
  }

  .search-input::placeholder {
    color: #52525b;
  }

  .search-input:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .search-input:focus {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    outline: none;
  }
</style>

<style is:global>
  #search-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #18181b;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    max-height: 320px;
    overflow-y: auto;
    z-index: 50;
    display: none;
    padding: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  #search-dropdown.active {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .search-item {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.1s ease-out;
  }

  .search-item:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .search-item:hover .search-item-title {
    color: #ffffff;
  }

  .search-item-info {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 14px;
    color: #a1a1aa;
  }

  .search-item-title {
    font-weight: 500;
    color: #fafafa;
  }

  .search-item-sep {
    color: #3f3f46;
    margin: 0 6px;
  }

  .search-item-artist {
    color: #71717a;
  }
</style>
