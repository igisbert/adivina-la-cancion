---
interface Props {
  nextSlug: string | null;
}

const { nextSlug } = Astro.props;
---

<nav id="game-nav" class="game-nav-bottom" style="display: none;">
  <a href="/" class="nav-link nav-menu">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    Menú
  </a>
  {nextSlug && (
    <a href={`/cancion/${nextSlug}`} class="nav-link nav-next">
      Siguiente
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  )}
</nav>

<style>
  .game-nav-bottom {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    width: 100%;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 14px;
    color: #71717a;
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    transition: color 0.15s ease-out, background 0.15s ease-out;
  }

  .nav-link:hover {
    color: #fafafa;
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-menu {
    flex: 1;
  }

  .nav-next {
    flex: 3;
    background: #fafafa;
    color: #09090b;
  }

  .nav-next:hover {
    background: #e4e4e7;
    color: #09090b;
  }
</style>
