---
interface Props {
  id?: string;
}

const { id = "waveform" } = Astro.props;

const delays = [0, 0.07, 0.14, 0.21, 0.28, 0.35, 0.42, 0.49, 0.56, 0.63, 0.7, 0.77];
---

<div id={id} class="waveform">
  {delays.map((d, i) => (
    <div class="wave-bar" style={`animation-delay: ${d}s`}></div>
  ))}
</div>

<style>
  .waveform {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 48px;
    width: 100%;
    max-width: 320px;
    opacity: 0.25;
    transition: opacity 0.3s ease-out;
  }

  .waveform.playing {
    opacity: 1;
  }

  .wave-bar {
    width: 4px;
    height: 12px;
    background: #52525b;
    border-radius: 2px;
  }

  .waveform.playing .wave-bar {
    background: #a1a1aa;
    animation: wave 0.8s ease-in-out infinite;
  }

  @keyframes wave {
    0%, 100% { height: 10px; }
    50% { height: 36px; }
  }
</style>
