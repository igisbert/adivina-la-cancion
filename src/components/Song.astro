---
interface Props {
  trackId: number;
  slug: string;
  artworkUrl: string;
  trackName: string;
  artistName: string;
}

const { trackId, slug, artworkUrl, trackName, artistName } = Astro.props;
---

<a href={`/cancion/${slug}`} class="song-card" data-song-id={trackId}>
  <div class="song-art-wrap">
    <img src={artworkUrl} alt="" class="song-art unplayed" loading="lazy" draggable="false" transition:name={`song-art-${slug}`} />
    <div class="song-lock">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0110 0v4"></path>
      </svg>
    </div>
    <div class="song-overlay">
      <span class="song-overlay-title">{trackName}</span>
      <span class="song-overlay-artist">{artistName}</span>
    </div>
  </div>
</a>

<style>
  .song-card {
    position: relative;
    display: block;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
  }

  .song-art-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #27272a;
  }

  .song-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.3s ease-out;
    -webkit-user-drag: none;
    user-select: none;
  }

  .song-art.unplayed {
    opacity: 0;
  }
</style>

<style is:global>
  .song-lock {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.3);
    z-index: 1;
  }

  .song-art:not(.unplayed) ~ .song-lock {
    display: none;
  }

  .song-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 12px 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.96) 0%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 2px;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.25s ease-out, opacity 0.25s ease-out;
    pointer-events: none;
    z-index: 1;
  }

  .song-art-wrap:hover .song-overlay {
    transform: translateY(0);
    opacity: 1;
  }

  .song-art.unplayed ~ .song-overlay {
    display: none;
  }

  .song-overlay-title {
    font-size: 15px;
    font-weight: 600;
    color: #fafafa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song-overlay-artist {
    font-size: 14px;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(9, 9, 11, 0.8);
    border: 1px solid #3f3f46;
    border-radius: 50%;
    color: #fafafa;
    backdrop-filter: blur(4px);
    z-index: 2;
  }
</style>
