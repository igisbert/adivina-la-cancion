---
interface Props {
  trackId: number;
  slug: string;
  artworkUrl: string;
  trackName: string;
  artistName: string;
}

const { trackId, slug, artworkUrl, trackName, artistName } = Astro.props;
---

<a href={`/cancion/${slug}`} class="song-card" data-song-id={trackId}>
  <div class="song-art-wrap">
    <img src={artworkUrl} alt="" class="song-art unplayed" loading="lazy" />
  </div>
  <div class="song-info">
    <div class="song-title">{trackName}</div>
    <div class="song-artist">{artistName}</div>
  </div>
</a>

<style>
  .song-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s ease-out;
  }

  .song-art-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #27272a;
  }

  .song-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.3s ease-out;
  }

  .song-art.unplayed {
    filter: grayscale(100%) blur(16px) saturate(0.4);
    transform: scale(1.15);
  }

  .song-info {
    padding: 10px 12px 12px;
    display: none;
  }

  .song-info.revealed {
    display: block;
  }

  .song-title {
    font-size: 13px;
    font-weight: 500;
    color: #fafafa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song-artist {
    font-size: 12px;
    color: #71717a;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 2px;
  }

  .song-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(9, 9, 11, 0.8);
    border: 1px solid #3f3f46;
    border-radius: 50%;
    color: #fafafa;
    backdrop-filter: blur(4px);
  }
</style>
