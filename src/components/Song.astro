---
interface Props {
  trackId: number;
  slug: string;
  artworkUrl: string;
  trackName: string;
  artistName: string;
}

const { trackId, slug, artworkUrl, trackName, artistName } = Astro.props;
---

<a href={`/cancion/${slug}`} class="song-card" data-song-id={trackId} aria-label={`Canción ${slug}`}>
  <div class="song-art-wrap">
    <img src={`/art/pixelated/${slug}.webp`} alt={`Canción ${slug}`} class="song-art unplayed" data-original={artworkUrl} loading="lazy" draggable="false" transition:name={`song-art-${slug}`} />
    <div class="song-overlay">
      <span class="song-overlay-title">{trackName}</span>
      <span class="song-overlay-artist">{artistName}</span>
    </div>
  </div>
</a>

<style>
  .song-card {
    position: relative;
    display: block;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
  }

  .song-art-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #27272a;
  }

  .song-art {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.3s ease-out;
    -webkit-user-drag: none;
    user-select: none;
  }
</style>

<style is:global>
  .song-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 12px 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.96) 0%, transparent 100%);
    display: flex;
    flex-direction: column;
    gap: 2px;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.25s ease-out, opacity 0.25s ease-out;
    pointer-events: none;
    z-index: 1;
  }

  .song-art-wrap:hover .song-overlay {
    transform: translateY(0);
    opacity: 1;
  }

  .song-art.unplayed ~ .song-overlay {
    display: none;
  }

  .song-overlay-title {
    font-size: 15px;
    font-weight: 600;
    color: #fafafa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song-overlay-artist {
    font-size: 14px;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    min-width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 600;
    color: #fafafa;
    backdrop-filter: blur(4px);
    z-index: 2;
    animation: badge-pop 0.2s ease-out 0.15s both;
  }

  @keyframes badge-pop {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .badge-green {
    background: rgba(34, 197, 94, 0.85);
    border: 1px solid rgba(34, 197, 94, 0.4);
  }

  .badge-orange {
    background: rgba(249, 115, 22, 0.85);
    border: 1px solid rgba(249, 115, 22, 0.4);
  }

  .badge-red {
    background: rgba(239, 68, 68, 0.85);
    border: 1px solid rgba(239, 68, 68, 0.4);
  }
</style>
