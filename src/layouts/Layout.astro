---
import "@fontsource-variable/jost";
import { ClientRouter } from "astro:transitions";
import StatsModal from "../components/StatsModal.astro";

interface Props {
  title?: string;
}

const { title = "Adivina la canción" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
    <StatsModal />
  </body>
</html>

<script is:inline>
  function syncProgress(doc) {
    let progress;
    try {
      progress = JSON.parse(localStorage.getItem("musicgame_progress") || "{}");
    } catch {
      progress = {};
    }

    doc.querySelectorAll("[data-song-id]").forEach((el) => {
      const id = el.dataset.songId;
      if (progress[id]) {
        const img = el.querySelector(".song-art");
        if (img) {
          img.classList.remove("unplayed");
          if (img.dataset.original) img.src = img.dataset.original;
        }
        const artWrap = el.querySelector(".song-art-wrap");
        if (artWrap && !artWrap.querySelector(".song-badge")) {
          const badge = document.createElement("div");
          badge.className = "song-badge";
          if (progress[id].solved) {
            const attempts = progress[id].attempts;
            badge.textContent = attempts;
            badge.classList.add(attempts <= 2 ? "badge-green" : "badge-orange");
          } else {
            badge.innerHTML =
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
            badge.classList.add("badge-red");
          }
          artWrap.appendChild(badge);
        }
      }
    });

    const gameMain = doc.querySelector(".game");
    if (gameMain && gameMain.dataset.song) {
      try {
        const songData = JSON.parse(decodeURIComponent(gameMain.dataset.song));
        if (progress[songData.trackId]) {
          const artwork = doc.getElementById("artwork");
          if (artwork) {
            if (artwork.dataset.original)
              artwork.src = artwork.dataset.original;
          }
          const titleText = doc.getElementById("title-text");
          const artistText = doc.getElementById("artist-text");
          const titleReveal = doc.getElementById("title-reveal");
          const gameNav = doc.getElementById("game-nav");
          if (titleText) titleText.textContent = songData.trackName;
          if (artistText) artistText.textContent = songData.artistName;
          if (titleReveal) titleReveal.classList.add("visible");
          if (gameNav) gameNav.classList.add("visible");
        }
      } catch {}
    }
  }

  if (!window.__vtSync) {
    window.__vtSync = true;
    document.addEventListener("astro:before-swap", (event) => {
      syncProgress(event.newDocument);
    });
  }

  syncProgress(document);
</script>

<style is:global>
  ::view-transition-old(*),
  ::view-transition-new(*) {
    border-radius: 16px;
    overflow: hidden;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100dvh;
    font-family: "Jost Variable", system-ui, sans-serif;
    background: #09090b;
    color: #fafafa;
    -webkit-font-smoothing: antialiased;
  }

  html {
    scrollbar-gutter: stable;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    -webkit-user-drag: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
  }

  input {
    font: inherit;
    border: none;
    background: none;
    color: inherit;
    outline: none;
  }
</style>
