---
import '@fontsource-variable/jost';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
}

const { title = 'Adivina la Canción' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<script is:inline>
  if (!window.__vtSync) {
    window.__vtSync = true;

    document.addEventListener('astro:before-swap', (event) => {
      const newDoc = event.newDocument;
      let progress;
      try {
        progress = JSON.parse(localStorage.getItem('musicgame_progress') || '{}');
      } catch { progress = {}; }

      newDoc.querySelectorAll('[data-song-id]').forEach((el) => {
        const id = el.dataset.songId;
        if (progress[id]) {
          const img = el.querySelector('.song-art');
          if (img) {
            img.classList.remove('unplayed');
            if (img.dataset.original) img.src = img.dataset.original;
          }
          const artWrap = el.querySelector('.song-art-wrap');
          if (artWrap && !artWrap.querySelector('.song-badge')) {
            const badge = document.createElement('div');
            badge.className = 'song-badge';
            if (progress[id].solved) {
              badge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"></path></svg>';
            } else {
              badge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
            }
            artWrap.appendChild(badge);
          }
        }
      });

      const gameMain = newDoc.querySelector('.game');
      if (gameMain && gameMain.dataset.song) {
        try {
          const songData = JSON.parse(gameMain.dataset.song);
          if (progress[songData.trackId]) {
            const artwork = newDoc.getElementById('artwork');
            if (artwork) {
              if (artwork.dataset.original) artwork.src = artwork.dataset.original;
            }
            const titleText = newDoc.getElementById('title-text');
            const artistText = newDoc.getElementById('artist-text');
            const titleReveal = newDoc.getElementById('title-reveal');
            if (titleText) titleText.textContent = songData.trackName;
            if (artistText) artistText.textContent = songData.artistName;
            if (titleReveal) titleReveal.classList.add('visible');
          }
        } catch {}
      }
    });
  }
</script>

<style is:global>
  @import '@fontsource-variable/jost';

  ::view-transition-old(*),
  ::view-transition-new(*) {
    border-radius: 16px;
    overflow: hidden;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100dvh;
    font-family: 'Jost Variable', system-ui, sans-serif;
    background: #09090b;
    color: #fafafa;
    -webkit-font-smoothing: antialiased;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    -webkit-user-drag: none;
    user-select: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
    cursor: pointer;
    border: none;
    background: none;
    color: inherit;
  }

  input {
    font: inherit;
    border: none;
    background: none;
    color: inherit;
    outline: none;
  }
</style>
