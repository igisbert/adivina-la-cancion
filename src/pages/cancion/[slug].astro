---
import Layout from '../../layouts/Layout.astro';
import PlayButton from '../../components/PlayButton.astro';
import ResetButton from '../../components/ResetButton.astro';
import SkipButton from '../../components/SkipButton.astro';
import AttemptsDisplay from '../../components/AttemptsDisplay.astro';
import SearchInput from '../../components/SearchInput.astro';
import Waveform from '../../components/Waveform.astro';
import GameNav from '../../components/GameNav.astro';
import VolumeControl from '../../components/VolumeControl.astro';
import songs from '../../data/songs.json';

export function getStaticPaths() {
  return songs.map((song, index) => ({
    params: { slug: song.slug },
    props: {
      song,
      currentIndex: index,
      nextSlug: index < songs.length - 1 ? songs[index + 1].slug : null,
    },
  }));
}

const { song, currentIndex, nextSlug } = Astro.props;
---

<Layout title="Adivina la Canción">
  <script type="module">
    import confetti from 'canvas-confetti';
    window.fireConfetti = confetti;
  </script>
  <main class="game" data-song={JSON.stringify(song)}>
    <nav class="game-nav">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Todas las canciones
      </a>
    </nav>

    <div class="game-center">
      <div class="artwork-wrap">
        <div class="artwork-frame" transition:name={`song-art-${song.slug}`}>
          <img
            src={`/art/pixelated/${song.slug}.webp`}
            alt=""
            id="artwork"
            class="artwork"
            data-original={song.artworkUrl100}
            draggable="false"
          />
        </div>
        <div id="title-reveal" class="title-reveal">
          <span id="title-text"></span>
          <span class="title-sep"> de </span>
          <span id="artist-text"></span>
        </div>
      </div>

      <Waveform id="waveform" />

      <div class="input-area">
        <SearchInput id="guess-input" placeholder="Adivina la canción..." />
      </div>

      <AttemptsDisplay id="attempts-display" />

      <div class="controls-group">
        <div class="button-row">
          <PlayButton id="play-button" />
          <ResetButton id="reset-button" />
          <SkipButton id="skip-button" />
        </div>

        <VolumeControl />
      </div>

      <GameNav nextSlug={nextSlug} />
    </div>
  </main>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const gameEl = document.querySelector('.game');
      if (!gameEl) return;
      const songData = JSON.parse(gameEl.dataset.song);
    const audio = new Audio();

    document.addEventListener('astro:before-preparation', () => {
      audio.pause();
      if (playTimeout) clearTimeout(playTimeout);
    });
    const playButton = document.getElementById('play-button');
    const resetButton = document.getElementById('reset-button');
    const skipButton = document.getElementById('skip-button');
    const attemptsDisplay = document.getElementById('attempts-display');
    const guessInput = document.getElementById('guess-input');
    const guessDropdown = document.getElementById('search-dropdown');
    const artwork = document.getElementById('artwork');
    const waveform = document.getElementById('waveform');
    const titleReveal = document.getElementById('title-reveal');
    const titleText = document.getElementById('title-text');
    const artistText = document.getElementById('artist-text');
    const gameNav = document.getElementById('game-nav');

    const INTERVALS = [0.5, 1.25, 2.5, 3.75, 5, 9];
    let currentAttempt = 0;
    let solved = false;
    let gameOver = false;
    let guesses = [];
    let playTimeout = null;
    let currentRequestId = 0;
    let debounceTimer = null;

    audio.src = songData.previewUrl;
    audio.preload = 'auto';

    const volumeSlider = document.getElementById('volume-slider');
    const savedVolume = localStorage.getItem('musicgame_volume');
    if (savedVolume !== null) volumeSlider.value = savedVolume;
    audio.volume = parseFloat(volumeSlider.value);
    volumeSlider.addEventListener('input', (e) => {
      audio.volume = parseFloat(e.target.value);
      localStorage.setItem('musicgame_volume', e.target.value);
    });

    audio.addEventListener('ended', () => {
      updatePlayButton(false);
      waveform.classList.remove('playing');
    });

    const updatePlayButton = (playing) => {
      playButton.innerHTML = playing
        ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>'
        : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>';
    };

    const existingProgress = (() => {
      try {
        const all = JSON.parse(localStorage.getItem('musicgame_progress') || '{}');
        return all[songData.trackId] || null;
      } catch { return null; }
    })();

    if (existingProgress) {
      solved = existingProgress.solved;
      guesses = existingProgress.guesses || [];
      currentAttempt = guesses.length;
      gameOver = true;

      if (artwork.dataset.original) artwork.src = artwork.dataset.original;
      titleText.textContent = songData.trackName;
      artistText.textContent = songData.artistName;
      titleReveal.classList.add('visible');

      guessInput.disabled = true;
      guessInput.placeholder = solved ? '¡Adivinada!' : 'Fin del juego';
      skipButton.disabled = true;

      const dots = attemptsDisplay.querySelectorAll('.attempt-dot');
      guesses.forEach((g, i) => {
        if (dots[i]) {
          dots[i].classList.add(solved && i === guesses.length - 1 ? 'correct' : 'wrong');
        }
      });

      gameNav.style.display = 'flex';
    }

    function playSegment() {
      if (playTimeout) clearTimeout(playTimeout);

      audio.currentTime = 0;

      audio.play().then(() => {
        if (!gameOver) {
          const duration = INTERVALS[currentAttempt];

          playTimeout = setTimeout(() => {
            audio.pause();
            audio.currentTime = 0;
            updatePlayButton(false);
            waveform.classList.remove('playing');
          }, duration * 1000);
        }

        updatePlayButton(true);
        waveform.classList.add('playing');
      }).catch(err => console.error('Playback failed:', err));
    }

    function revealSong() {
      if (artwork.dataset.original) artwork.src = artwork.dataset.original;
      titleText.textContent = songData.trackName;
      artistText.textContent = songData.artistName;
      titleReveal.classList.add('visible');

      guessInput.disabled = true;
      guessInput.placeholder = 'Fin del juego';

      if (playTimeout) clearTimeout(playTimeout);
      audio.pause();
      waveform.classList.remove('playing');
      updatePlayButton(false);
    }

    const saveProgress = (solvedStatus) => {
      try {
        const progress = JSON.parse(localStorage.getItem('musicgame_progress') || '{}');
        progress[songData.trackId] = {
          guesses: guesses.map(g => ({ id: g.trackId, name: g.trackName, artist: g.artistName })),
          solved: solvedStatus,
          attempts: guesses.length,
          timestamp: Date.now()
        };
        localStorage.setItem('musicgame_progress', JSON.stringify(progress));

        const stats = JSON.parse(localStorage.getItem('musicgame_stats') || '{"played":0,"wins":0,"streak":0,"maxStreak":0,"distribution":{}}');
        stats.played += 1;
        if (solvedStatus) {
          stats.wins += 1;
          stats.streak += 1;
          stats.maxStreak = Math.max(stats.maxStreak, stats.streak);
          stats.distribution[guesses.length] = (stats.distribution[guesses.length] || 0) + 1;
        } else {
          stats.streak = 0;
        }
        localStorage.setItem('musicgame_stats', JSON.stringify(stats));
      } catch (e) {
        console.error('Storage error:', e);
      }
    };

    function normalize(str) {
      return str
        .toLowerCase()
        .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/[\s]*\(.*?\)[\s]*/g, ' ')
        .replace(/[\s]*\[.*?\][\s]*/g, ' ')
        .replace(/[¿?!,.:;'"¡]/g, '')
        .replace(/\s+/g, ' ')
        .trim();
    }

    function handleGuess(song) {
      if (gameOver) return;

      guesses.push(song);

      const isCorrect = song.trackId === songData.trackId ||
        (normalize(song.trackName) === normalize(songData.trackName) &&
         normalize(song.artistName) === normalize(songData.artistName));
      const dots = attemptsDisplay.querySelectorAll('.attempt-dot');

      if (isCorrect) {
        solved = true;
        gameOver = true;
        dots[currentAttempt]?.classList.add('correct');
        revealSong();
        window.fireConfetti({ particleCount: 150, spread: 80, origin: { y: 0.2 } });
        gameNav.style.display = 'flex';
      } else {
        dots[currentAttempt]?.classList.add('wrong');
        currentAttempt++;
        if (currentAttempt >= INTERVALS.length) {
          gameOver = true;
          revealSong();
          gameNav.style.display = 'flex';
        }
      }

      saveProgress(isCorrect);
    }

    function handleSkip() {
      if (gameOver) return;

      attemptsDisplay.querySelectorAll('.attempt-dot')[currentAttempt]?.classList.add('wrong');
      guesses.push({ trackId: 0, trackName: 'Skip', artistName: '' });
      currentAttempt++;

      if (playTimeout) clearTimeout(playTimeout);
      audio.pause();
      waveform.classList.remove('playing');
      updatePlayButton(false);

      if (currentAttempt >= INTERVALS.length) {
        gameOver = true;
        revealSong();
        gameNav.style.display = 'flex';
      }

      saveProgress(false);
    }

    const escapeHtml = (text) => {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    };

    const searchSongs = async (query) => {
      const requestId = ++currentRequestId;

      try {
        const response = await fetch(
          `https://itunes.apple.com/search?term=${encodeURIComponent(query)}&entity=song&limit=8`
        );

        if (requestId !== currentRequestId) return;

        const data = await response.json();
        data.results?.length > 0 ? showDropdown(data.results) : hideDropdown();
      } catch (error) {
        console.error('Search error:', error);
        hideDropdown();
      }
    };

    const showDropdown = (results) => {
      guessDropdown.innerHTML = '';

      results.forEach(song => {
        const item = document.createElement('div');
        item.className = 'search-item';
        item.innerHTML = `<div class="search-item-info"><span class="search-item-title">${escapeHtml(song.trackName)}</span><span class="search-item-sep"> - </span><span class="search-item-artist">${escapeHtml(song.artistName)}</span></div>`;

        item.addEventListener('click', () => {
          handleGuess(song);
          hideDropdown();
          guessInput.value = '';
        });

        guessDropdown.appendChild(item);
      });

      guessDropdown.classList.add('active');
    };

    const hideDropdown = () => {
      guessDropdown.classList.remove('active');
      guessDropdown.innerHTML = '';
    };

    playButton.addEventListener('click', () => {
      if (audio.paused) {
        if (audio.currentTime === 0 || audio.ended) {
          playSegment();
        } else {
          audio.play().then(() => {
            updatePlayButton(true);
            waveform.classList.add('playing');
            if (!gameOver) {
              playTimeout = setTimeout(() => {
                audio.pause();
                updatePlayButton(false);
                waveform.classList.remove('playing');
              }, (INTERVALS[currentAttempt] - audio.currentTime) * 1000);
            }
          }).catch(err => console.error('Playback failed:', err));
        }
      } else {
        if (playTimeout) clearTimeout(playTimeout);
        audio.pause();
        updatePlayButton(false);
        waveform.classList.remove('playing');
      }
    });

    resetButton.addEventListener('click', () => {
      if (playTimeout) clearTimeout(playTimeout);
      audio.pause();
      audio.currentTime = 0;
      updatePlayButton(false);
      waveform.classList.remove('playing');
    });

    skipButton.addEventListener('click', handleSkip);

    guessInput.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      if (debounceTimer) clearTimeout(debounceTimer);
      if (query.length < 2) { hideDropdown(); return; }
      debounceTimer = setTimeout(() => searchSongs(query), 400);
    });

    guessInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideDropdown();
        guessInput.blur();
      }
    });

    document.addEventListener('click', (e) => {
      if (!guessInput.contains(e.target) && !guessDropdown.contains(e.target)) {
        hideDropdown();
      }
    });
    });
  </script>
</Layout>

<style>
  .game {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .game-nav {
    padding: 16px 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #71717a;
    text-decoration: none;
  }

  .game-center {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 24px 48px;
    gap: 32px;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .artwork-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .artwork-frame {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    width: 100%;
  }

  .artwork {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 16px;
    object-fit: cover;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
    transition: opacity 0.6s ease-out;
    -webkit-user-drag: none;
    user-select: none;
  }

  .title-reveal {
    text-align: center;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    pointer-events: none;
  }

  .title-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .title-reveal #title-text {
    font-size: 20px;
    font-weight: 600;
    color: #fafafa;
  }

  .title-sep {
    font-size: 16px;
    color: #71717a;
    margin: 0 6px;
  }

  .title-reveal #artist-text {
    font-size: 16px;
    color: #a1a1aa;
  }

  .input-area {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .controls-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: fit-content;
  }

  .button-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
</style>
