---
import Layout from "../layouts/Layout.astro";
import SongsGrid from "../components/SongsGrid.astro";
import songs from "../data/songs.json";
import "@fontsource/cinzel-decorative";
---

<Layout title="Adivina la Canción">
  <main class="main">
    <header class="header">
      <h1 class="title">Adivina la Canción</h1>
      <p class="subtitle">Desenmascara las {songs.length} canciones con el menor número de intentos</p>
    </header>

    <SongsGrid />

    <footer class="footer">
      <p>El progreso se guarda solo en este dispositivo.</p>
    </footer>
  </main>

  <script is:inline>
    (function () {
      const progress = (() => {
        try {
          return JSON.parse(localStorage.getItem("musicgame_progress") || "{}");
        } catch {
          return {};
        }
      })();
      const cards = document.querySelectorAll(".song-card");

      cards.forEach((card) => {
        const songId = card.dataset.songId;
        const songProgress = progress[songId];

        if (songProgress) {
          const img = card.querySelector(".song-art");
          if (img) {
            img.classList.remove("unplayed");
          }

          const artWrap = card.querySelector(".song-art-wrap");
          if (artWrap && !artWrap.querySelector(".song-badge")) {
            const badge = document.createElement("div");
            badge.className = "song-badge";

            if (songProgress.solved) {
              const attempts = songProgress.attempts;
              badge.textContent = attempts;
              badge.classList.add(
                attempts <= 2 ? "badge-green" : "badge-orange",
              );
            } else {
              badge.innerHTML =
                '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
              badge.classList.add("badge-red");
            }

            artWrap.appendChild(badge);
          }
        }
      });
    })();
  </script>
</Layout>

<style>
  .main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .header {
    text-align: center;
    padding: 56px 24px 40px;
  }

  .title {
    font-family: 'Cinzel Decorative', serif;
    font-size: clamp(28px, 6vw, 64px);
    color: #fafafa;
    margin: 0 0 8px;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 16px;
    color: #71717a;
    margin: 0;
    text-wrap: balance;
  }

  .footer {
    margin-top: auto;
    padding: 32px 24px;
    text-align: center;
    border-top: 1px solid #18181b;
  }

  .footer p {
    font-size: 12px;
    color: #52525b;
    margin: 0;
  }
</style>
