---
import Layout from "../layouts/Layout.astro";
import SongsGrid from "../components/SongsGrid.astro";
import songs from "../data/songs.json";
import "@fontsource/cinzel-decorative";
---

<Layout title="Adivina la Canción">
  <main class="main">
    <header class="header">
      <h1 class="title">Adivina la Canción</h1>
      <p class="subtitle">Desenmascara las {songs.length} canciones con el menor número de intentos</p>
    </header>

    <SongsGrid />

    <footer class="footer">
      <p>El progreso se guarda solo en este dispositivo.</p>
    </footer>
  </main>
</Layout>

<style>
  .main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .header {
    text-align: center;
    padding: 56px 24px 40px;
  }

  .title {
    font-family: 'Cinzel Decorative', serif;
    font-size: clamp(28px, 6vw, 64px);
    color: #fafafa;
    margin: 0 0 8px;
    line-height: 1.1;
  }

  .subtitle {
    font-size: 16px;
    color: #71717a;
    margin: 0;
    text-wrap: balance;
  }

  .footer {
    margin-top: auto;
    padding: 32px 24px;
    text-align: center;
    border-top: 1px solid #18181b;
  }

  .footer p {
    font-size: 12px;
    color: #52525b;
    margin: 0;
  }
</style>
