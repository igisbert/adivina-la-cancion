---
import Layout from '../layouts/Layout.astro';
import SongsGrid from '../components/SongsGrid.astro';
import songs from '../data/songs.json';
import { Music } from '@lucide/astro';
---

<Layout title="Adivina la Canción">
  <main class="main">
    <header class="header">
      <div class="logo">
        <Music size={18} strokeWidth={1.5} />
      </div>
      <h1 class="title">Adivina la Canción</h1>
      <p class="subtitle">{songs.length} canciones por descubrir</p>
    </header>

    <SongsGrid />

    <footer class="footer">
      <p>El progreso se guarda solo en este navegador.</p>
    </footer>
  </main>

  <script is:inline>
    (function() {
      const progress = (() => {
        try {
          return JSON.parse(localStorage.getItem('musicgame_progress') || '{}');
        } catch { return {}; }
      })();
      const cards = document.querySelectorAll('.song-card');
      
      cards.forEach(card => {
        const songId = card.dataset.songId;
        const songProgress = progress[songId];
        
        if (songProgress) {
          const img = card.querySelector('.song-art');
          if (img) {
            img.classList.remove('unplayed');
          }
          
          const artWrap = card.querySelector('.song-art-wrap');
          if (artWrap && !artWrap.querySelector('.song-badge')) {
            const badge = document.createElement('div');
            badge.className = 'song-badge';
            
            if (songProgress.solved) {
              badge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"></path></svg>';
            } else {
              badge.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';
            }
            
            artWrap.appendChild(badge);
          }
        }
      });
    })();
  </script>
</Layout>

<style>
  .main {
    min-height: 100dvh;
  }

  .header {
    text-align: center;
    padding: 48px 24px 32px;
  }

  .logo {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 10px;
    color: #a1a1aa;
    margin: 0 auto 12px;
  }

  .title {
    font-size: 20px;
    font-weight: 500;
    color: #fafafa;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 14px;
    color: #71717a;
    margin: 0;
  }

  .footer {
    padding: 32px 24px;
    text-align: center;
  }

  .footer p {
    font-size: 12px;
    color: #52525b;
    margin: 0;
  }
</style>
